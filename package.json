{
  "name": "airlock",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted, multi-tenant API Gateway & Developer Platform",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f infra/docker/docker-compose.yml up --build",
    "dev:down": "docker compose -f infra/docker/docker-compose.yml down",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "migrate": "npm run migrate --workspace apps/gateway"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
