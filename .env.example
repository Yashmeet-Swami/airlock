# Gateway
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Postgres
DATABASE_URL=postgres://airlock:airlock@localhost:5432/airlock

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PROXY_UPSTREAM_TIMEOUT_MS=5000

# Mock upstream (dev/test fixture only)
MOCK_UPSTREAM_PORT=4000
