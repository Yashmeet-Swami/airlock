# Gateway
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Postgres
DATABASE_URL=postgres://airlock:airlock@localhost:5432/airlock

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PROXY_UPSTREAM_TIMEOUT_MS=5000

# Rate limiting fallback (used only when no policy row exists at all)
RATE_LIMIT_FALLBACK_LIMIT=60
RATE_LIMIT_FALLBACK_WINDOW_S=60

# OpenSearch (Phase 4 — log search/analytics)
OPENSEARCH_URL=http://localhost:9200

# Circuit breaker (Phase 5)
CIRCUIT_BREAKER_WINDOW_SIZE=20
CIRCUIT_BREAKER_FAILURE_THRESHOLD_PCT=50
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Proxy retries (Phase 5)
PROXY_MAX_RETRIES=2
PROXY_RETRY_BASE_MS=100

# MinIO (Phase 6 — request archival/replay, analytics export)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=airlock-minio
MINIO_SECRET_KEY=airlock-minio-secret
MINIO_USE_SSL=false
MINIO_ARCHIVE_BUCKET=request-archives
MINIO_EXPORTS_BUCKET=analytics-exports

# Workers (apps/workers) — webhook delivery + log indexing
WEBHOOK_DELIVERY_TIMEOUT_MS=5000
WEBHOOK_CONCURRENCY=5
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_MS=1000,5000,30000,120000,600000
LOG_INDEXER_CONCURRENCY=10
METRICS_PORT=3001

# Mock upstream (dev/test fixture only)
MOCK_UPSTREAM_PORT=4000
